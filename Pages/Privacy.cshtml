@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

<style>
    body {
        background-color: #f6f4f1;
        font-family: 'Georgia', serif;
    }

    .privacy-card {
        max-width: 700px;
        margin: 60px auto;
        background: #ffffff;
        border-radius: 20px;
        padding: 40px;
        text-align: center;
        border: 1px solid #e8dccb;
        box-shadow: 0 8px 20px rgba(0,0,0,0.04);
    }

    .privacy-title {
        color: #b8956a;
        letter-spacing: 2px;
        font-size: 14px;
        margin-bottom: 15px;
    }

    .privacy-card h1 {
        font-size: 32px;
        margin-bottom: 25px;
        color: #333;
    }

    .privacy-section {
        margin-bottom: 25px;
    }

        .privacy-section h2 {
            font-size: 18px;
            color: #b8956a;
            margin-bottom: 10px;
        }

        .privacy-section p {
            color: #555;
            line-height: 1.7;
            font-size: 15px;
        }

    .contact-email {
        color: #b8956a;
        font-weight: 500;
    }
</style>

<div class="privacy-card">

    <div class="privacy-title">PRIVACY</div>
    <h1>@ViewData["Title"]</h1>

    <div class="privacy-section">
        <p>
            This website is a digital invitation created to share wedding details
            with invited guests. We respect your privacy and keep this website
            simple and secure.
        </p>
    </div>

    <div class="privacy-section">
        <h2>Information Collection</h2>
        <p>
            We do not collect, store, or process any personal information
            from visitors.
        </p>
    </div>

    <div class="privacy-section">
        <h2>Cookies</h2>
        <p>
            This website does not use cookies or tracking technologies.
        </p>
    </div>

    <div class="privacy-section">
        <h2>Third-Party Services</h2>
        <p>
            This website does not use third-party services that collect visitor data.
        </p>
    </div>

    <div class="privacy-section">
        <h2>Contact</h2>
        <p>
            For any questions, please contact us at <br />
            <span class="contact-email">rashikmuhammedrasak@gmail.com</span>
        </p>
    </div>

</div>