<!-- ================= SCRIPT ================= -->
<script>

      let canvas, ctx;
    let particles = [];
    let fireworksInterval;
    let animationRunning = false;

    function enterInvitation(){
        document.getElementById("intro").style.display="none";
        document.getElementById("invite").style.display="flex";
        startCountdown();
        document.getElementById("bgMusic").play().catch(()=>{});
    }

    function showYes(){
        document.getElementById("celebration").style.display="flex";
        startFireworks();
    }

    function showNo(){
        document.getElementById("clckNo").style.display="flex";
    }

        function goBack(){
        document.getElementById("celebration").style.display="none";
        document.getElementById("clckNo").style.display="none"; 

        clearInterval(fireworksInterval);
        animationRunning = false;
        particles = [];

        if (ctx && canvas) {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
    }

    /* COUNTDOWN */
    function startCountdown(){
        let date=new Date("Nov 15, 2026 10:00:00").getTime();

        setInterval(()=>{
            let now=new Date().getTime();
            let diff=date-now;

            document.getElementById("days").innerHTML=Math.floor(diff/(1000*60*60*24));
            document.getElementById("hours").innerHTML=Math.floor((diff%(1000*60*60*24))/(1000*60*60));
            document.getElementById("minutes").innerHTML=Math.floor((diff%(1000*60*60))/(1000*60));
            document.getElementById("seconds").innerHTML=Math.floor((diff%(1000*60))/1000);

        },1000);
    }

    /* FIREWORKS START */
    function startFireworks(){

        canvas = document.getElementById("fireworksCanvas");
        ctx = canvas.getContext("2d");

        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;

        animationRunning = true;

        fireworksInterval = setInterval(() => {
            launchFirework();
        }, 500);

        animate();
    }

    /* CREATE BURST */
    function launchFirework(){

        let x = Math.random() * canvas.width;
        let y = Math.random() * canvas.height / 2;

        for (let i = 0; i < 60; i++) {
            particles.push({
                x,
                y,
                angle: Math.random() * 2 * Math.PI,
                speed: Math.random() * 6 + 2,
                radius: Math.random() * 3 + 1.5,
                alpha: 1,
                color: ["#ffd700","#ff4d6d","#6bcB77","#4d96ff","#ffffff"][Math.floor(Math.random()*5)]
            });
        }
    }

    /* LOOP */
    function animate(){

        if (!animationRunning) return;

        ctx.clearRect(0, 0, canvas.width, canvas.height);

        particles.forEach((p, i) => {

            p.x += Math.cos(p.angle) * p.speed;
            p.y += Math.sin(p.angle) * p.speed;
            p.alpha -= 0.012;

            ctx.globalAlpha = p.alpha;
            ctx.fillStyle = p.color;

            ctx.beginPath();
            ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
            ctx.fill();

            if (p.alpha <= 0) particles.splice(i, 1);
        });

        requestAnimationFrame(animate);
    }

                   function fitToScreen() {
        const card = document.querySelector('.pdf-page');
        if (!card) return;

        // Reset scale to measure the actual content height
        card.style.transform = 'scale(1)';

        const cardWidth = card.offsetWidth;
        const cardHeight = card.offsetHeight;
        const windowWidth = window.innerWidth;
        const windowHeight = window.innerHeight;

        // Calculate scale to fit both width and height (with 4% padding)
        const scaleX = (windowWidth * 0.96) / cardWidth;
        const scaleY = (windowHeight * 0.96) / cardHeight;

        // Pick the smallest scale so it fits perfectly in the window
        let finalScale = Math.min(scaleX, scaleY);

        // If on a large desktop where it already fits, don't scale UP
        if (finalScale > 1) finalScale = 1;

        card.style.transform = `scale(${finalScale})`;
    }

    // Update resize listener
    window.addEventListener('resize', fitToScreen);

    // Ensure this is called when entering
       function enterInvitation(){
        document.getElementById("intro").style.display="none";
        document.getElementById("invite").style.display="flex";

        // Re-call fitToScreen to ensure it centers based on the
        // now-visible height
        setTimeout(fitToScreen, 10);

        // Add this line to force the main scene to fill the space
        document.querySelector('.scene').style.height = window.innerHeight + 'px';

        startCountdown();
        document.getElementById("bgMusic").play().catch(()=>{});
    }

    // Also call it if the screen rotates
    window.addEventListener('resize', fitToScreen);

</script>